{
  "name": "novafreshmart-pos",
  "private": true,
  "version": "0.2.1",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:exe": "tsc && vite build && electron-builder",
    "publish": "tsc && vite build && electron-builder --publish always",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.novafreshmart.pos",
    "productName": "Nova FreshMart",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/novafreshmart-exe-icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "shortcutName": "Nova FreshMart",
      "menuCategory": "Nova FreshMart"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "PrintAgentSource/Output/Release/LunaPOSPrintAgent.exe",
        "to": "LunaPOSPrintAgent.exe"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "saadromez",
      "repo": "novafresh",
      "private": false,
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.22.8",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.38",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.31.2",
    "electron-updater": "^6.8.11",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.395.0",
    "mysql2": "^3.24.6",
    "react": "^18.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1",
    "zustand": "^4.5.2"
  },
  "description": "Nova FreshMart POS System",
  "author": "Nova FreshMart Supermarket Systems"
}
